---
/**
 * 覆写 Starlight 的 Head 组件：保留默认 head 输出，附加图书元信息、
 * 社交分享卡片、PWA 清单、RSS 与全站交互脚本。
 *
 * 注意：og:type / og:locale / og:site_name / og:url / twitter:card 由 Starlight
 * 默认 Head 输出，这里不再重复声明，避免同一 meta 出现两次。
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { BOOK, REPO, PINNED_SEARCHES } from '../consts';
import trending from '../data/trending.json';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const abs = (p: string) => (site ? new URL(base + p.replace(/^\//, ''), site).href : base + p);

const ogImage = abs('og.png');

/** 首页搜索热词 = 人工置顶词 + 构建期从书稿统计出的高频概念（去重，最多 10 个） */
const hotTerms = [
  ...new Set([...PINNED_SEARCHES, ...trending.map((t: { term: string }) => t.term)]),
].slice(0, 10);

// 访问统计：只有配置了环境变量才会注入（默认不采集任何数据）
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const UMAMI_ID = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const UMAMI_SRC = import.meta.env.PUBLIC_UMAMI_SRC ?? 'https://cloud.umami.is/script.js';
---

<Default />

<meta name="author" content={BOOK.author} />
<meta name="theme-color" content="#660874" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={BOOK.title} />
<meta name="twitter:image" content={ogImage} />
<meta name="book:author" content={BOOK.author} />
<meta name="book:publisher" content={BOOK.press} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
<link rel="manifest" href={`${base}manifest.webmanifest`} />
<link rel="alternate" type="application/rss+xml" title={`${BOOK.title} · 更新`} href={abs('rss.xml')} />

{
  GA_ID && (
    <>
      <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} async />
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
      </script>
    </>
  )
}

{
  UMAMI_ID && (
    <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_ID} data-do-not-track="true" />
  )
}

<script
  is:inline
  define:vars={{
    base,
    repo: `${REPO.owner}/${REPO.name}`,
    hot: hotTerms,
    trending,
    subscribe: import.meta.env.PUBLIC_SUBSCRIBE_ENDPOINT ?? '',
  }}
>
  window.__STB__ = { base: base, repo: repo, subscribe: subscribe };
  window.__STB_HOT__ = hot;
  window.__STB_TRENDING__ = trending;
</script>
<script>
  import '../scripts/book.js';
</script>
