---
/**
 * 覆写 Starlight 的 Head 组件：保留默认 head 输出，附加图书元信息、
 * 每页专属的社交分享卡片、PWA 清单、RSS 与全站交互脚本。
 *
 * 注意：og:type / og:locale / og:site_name / og:url / twitter:card 由 Starlight
 * 默认 Head 输出，这里不再重复声明，避免同一 meta 出现两次。
 */
import fs from 'node:fs';
import path from 'node:path';
import Default from '@astrojs/starlight/components/Head.astro';
import { BOOK, COMPANION, REPO, PINNED_SEARCHES } from '../consts';
import trending from '../data/trending.json';
import { PALETTE, defaultSwatch, hslHex, hexToHsl } from '../palette';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const abs = (p: string) => (site ? new URL(base + p.replace(/^\//, ''), site).href : base + p);

/** 当前页在站点内的相对路径，例如 part1/ch1 或 en/brief */
const rel = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
const pagePath = rel.replace(/^\/+|\/+$/g, '');
const slug = pagePath === '' ? 'index' : pagePath.replace(/\//g, '-');

/**
 * 分享卡片查找顺序：
 *   英文页 → en-xxx.jpg，其次复用同名的中文卡片（章节尚未翻译）
 *   其他页 → xxx.jpg
 *   都没有 → index.jpg（书籍封面）
 * 卡片由 scripts/generate-og-images.mjs 预生成并提交仓库。
 */
const ogDir = path.join(process.cwd(), 'public', 'og');
const candidates = slug.startsWith('en-') ? [slug, slug.slice(3)] : [slug];
candidates.push('index');
const card = candidates.find((s) => fs.existsSync(path.join(ogDir, `${s}.jpg`)));
const ogImage = card ? abs(`og/${card}.jpg`) : abs('og.png');
const ogImageType = card ? 'image/jpeg' : 'image/png';

/**
 * 配色：默认取自 src/palette.ts 的 DEFAULT_ACCENT。
 * theme-color 用默认色的深调（同时也是面板里未选择时的初始值）。
 */
const accentDefault = defaultSwatch();
const deepHsl = hexToHsl(accentDefault.hex);
const themeColor = hslHex(deepHsl.h, Math.max(30, deepHsl.s), 30);

/** 首页搜索热词 = 人工置顶词 + 构建期从书稿统计出的高频概念（去重，最多 10 个） */
const hotTerms = [
  ...new Set([...PINNED_SEARCHES, ...trending.map((t: { term: string }) => t.term)]),
].slice(0, 10);

// 访问统计：只有配置了环境变量才会注入（默认不采集任何数据）
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const UMAMI_ID = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const UMAMI_SRC = import.meta.env.PUBLIC_UMAMI_SRC ?? 'https://cloud.umami.is/script.js';
---

<Default />

{BOOK.authors.map((a) => (<meta name="author" content={a} />))}
<meta name="theme-color" content={themeColor} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={BOOK.title} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={BOOK.title} />
<meta name="book:author" content={BOOK.author} />
<link rel="related" href={COMPANION.url} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
<link rel="manifest" href={`${base}manifest.webmanifest`} />
<link rel="alternate" type="application/rss+xml" title={`${BOOK.title} · 更新`} href={abs('rss.xml')} />

{
  GA_ID && (
    <>
      <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} async />
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
      </script>
    </>
  )
}

{
  UMAMI_ID && (
    <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_ID} data-do-not-track="true" />
  )
}

<script
  is:inline
  define:vars={{
    base,
    repo: `${REPO.owner}/${REPO.name}`,
    hot: hotTerms,
    trending,
    subscribe: import.meta.env.PUBLIC_SUBSCRIBE_ENDPOINT ?? '',
    palette: PALETTE,
    accentDefault: accentDefault.name,
  }}
>
  window.__STB__ = { base: base, repo: repo, subscribe: subscribe };
  window.__STB_HOT__ = hot;
  window.__STB_TRENDING__ = trending;
  window.__STB_PALETTE__ = palette;
  window.__STB_ACCENT_DEFAULT__ = accentDefault;
</script>
<script>
  import '../scripts/book.js';
</script>
