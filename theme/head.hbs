<meta name="description" content="《DeepSeek Harness 应用开发实践》——基于 DeepSeek Harness 的智能体应用开发实战手册，郭涛著，清华大学出版社。">
<meta property="og:title" content="DeepSeek Harness 应用开发实践">
<meta property="og:description" content="智能体应用开发实战手册：插件架构、多模型接入、插件开发与多智能体协同。">
<meta property="og:type" content="book">
<meta property="og:locale" content="zh_CN">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="favicon.svg">
<meta name="theme-color" content="#660874">


<script>
(function () {
    function ready(fn) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
        else fn();
    }

    ready(function () {
        /* 1. 阅读进度条 */
        var bar = document.createElement('div');
        bar.className = 'reading-progress';
        document.body.appendChild(bar);
        window.addEventListener('scroll', function () {
            var h = document.documentElement;
            var scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
            bar.style.width = (isNaN(scrolled) ? 0 : scrolled) + '%';
        }, { passive: true });

        /* 2. 阅读位置记忆 */
        var KEY = 'stb-scroll-' + location.pathname;
        var saved = localStorage.getItem(KEY);
        if (saved) window.scrollTo(0, parseInt(saved, 10));
        var t;
        window.addEventListener('scroll', function () {
            clearTimeout(t);
            t = setTimeout(function () { localStorage.setItem(KEY, String(window.scrollY)); }, 200);
        }, { passive: true });

        /* 3. 代码复制提示 */
        var toast = document.createElement('div');
        toast.className = 'copy-toast';
        toast.textContent = '已复制到剪贴板';
        document.body.appendChild(toast);
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('button');
            if (btn && /copy/i.test(btn.textContent || '')) {
                toast.classList.add('show');
                clearTimeout(toast._t);
                toast._t = setTimeout(function () { toast.classList.remove('show'); }, 1500);
            }
        });

        /* 4. 代码块语言标签 */
        document.querySelectorAll('pre').forEach(function (pre) {
            var code = pre.querySelector('code');
            if (!code) return;
            var m = (code.className || '').match(/language-([a-z0-9+#]+)/i);
            if (m) {
                var tag = document.createElement('span');
                tag.className = 'code-lang-tag';
                tag.textContent = m[1];
                pre.appendChild(tag);
            }
        });

        /* 5. 超长代码折叠 */
        document.querySelectorAll('pre').forEach(function (pre) {
            if (pre.scrollHeight > 500 && pre.clientHeight > 0) {
                pre.classList.add('code-collapsed');
                var btn = document.createElement('button');
                btn.className = 'code-expand-btn';
                btn.textContent = '展开全部代码';
                pre.parentNode.insertBefore(btn, pre.nextSibling);
                btn.addEventListener('click', function () {
                    pre.classList.remove('code-collapsed');
                    btn.remove();
                });
            }
        });

        /* 6. 本页目录 */
        var content = document.querySelector('main .content, main');
        if (content) {
            var heads = content.querySelectorAll('h2, h3');
            if (heads.length >= 3) {
                var toc = document.createElement('nav');
                toc.className = 'page-toc';
                var title = document.createElement('div');
                title.className = 'toc-title';
                title.textContent = '本页目录';
                toc.appendChild(title);
                heads.forEach(function (h) {
                    if (!h.id) h.id = 'sec-' + Math.random().toString(36).slice(2, 8);
                    var a = document.createElement('a');
                    a.href = '#' + h.id;
                    a.textContent = h.textContent;
                    if (h.tagName === 'H3') a.className = 'l3';
                    toc.appendChild(a);
                });
                var firstH = content.querySelector('h1, h2, h3, p');
                if (firstH) content.insertBefore(toc, firstH);
            }
        }

        /* 7. 图片说明（用 alt 文本做 caption） */
        document.querySelectorAll('main img').forEach(function (img) {
            var alt = img.getAttribute('alt');
            if (alt && alt.trim() && alt.indexOf('![') !== 0 && img.closest('pre') === null) {
                var cap = document.createElement('div');
                cap.className = 'img-caption';
                cap.textContent = alt;
                if (img.nextSibling) img.parentNode.insertBefore(cap, img.nextSibling);
                else img.parentNode.appendChild(cap);
            }
        });

        /* 8. 移动端表格卡片化（给 td 加 data-label） */
        document.querySelectorAll('table').forEach(function (table) {
            var headers = [];
            table.querySelectorAll('thead th').forEach(function (th) { headers.push(th.textContent.trim()); });
            if (!headers.length) return;
            table.querySelectorAll('tbody tr').forEach(function (tr) {
                tr.querySelectorAll('td').forEach(function (td, i) {
                    if (headers[i]) td.setAttribute('data-label', headers[i]);
                });
            });
        });

        /* 9. 评论区 giscus */
        (function loadGiscus() {
            var repoId = 'R_kgDOUaBS6w';
            var categoryId = 'DIC_kwDOUaBS684DFkpJ';
            if (!repoId || !categoryId) return;
            var container = document.createElement('div');
            container.id = 'giscus-container';
            container.style.marginTop = '2.5rem';
            var main = document.querySelector('main');
            if (!main) return;
            main.appendChild(container);
            var s = document.createElement('script');
            s.src = 'https://giscus.app/client.js';
            s.setAttribute('data-repo', 'guotao0628/shutongbuddy');
            s.setAttribute('data-repo-id', repoId);
            s.setAttribute('data-category', 'Announcements');
            s.setAttribute('data-category-id', categoryId);
            s.setAttribute('data-mapping', 'pathname');
            s.setAttribute('data-reactions-enabled', '1');
            s.setAttribute('data-input-position', 'bottom');
            s.setAttribute('data-theme', 'preferred_color_scheme');
            s.setAttribute('data-lang', 'zh-CN');
            s.setAttribute('crossorigin', 'anonymous');
            s.async = true;
            container.appendChild(s);
        })();

        /* 10. 字号调节 A-/A+ */
        var fontCtl = document.createElement('div');
        fontCtl.style.cssText = 'position:fixed;right:20px;bottom:74px;z-index:9997;display:flex;flex-direction:column;gap:6px;';
        var decBtn = document.createElement('button');
        decBtn.className = 'font-ctl-btn'; decBtn.textContent = 'A-'; decBtn.title = '缩小字号';
        var incBtn = document.createElement('button');
        incBtn.className = 'font-ctl-btn'; incBtn.textContent = 'A+'; incBtn.title = '放大字号';
        fontCtl.appendChild(decBtn); fontCtl.appendChild(incBtn);
        document.body.appendChild(fontCtl);
        var FONT_KEY = 'stb-font-size-v2';
        function getFont() { return parseInt(localStorage.getItem(FONT_KEY) || '14', 10); }
        function applyFont() {
            var saved = localStorage.getItem(FONT_KEY);
            if (saved) document.documentElement.style.setProperty('--stb-font-size', saved + 'px');
            else document.documentElement.style.removeProperty('--stb-font-size');  // 未自定义时跟随 CSS（桌面14/移动13.5）
        }
        applyFont();
        decBtn.addEventListener('click', function () { localStorage.setItem(FONT_KEY, String(Math.max(12, getFont() - 1))); applyFont(); });
        incBtn.addEventListener('click', function () { localStorage.setItem(FONT_KEY, String(Math.min(20, getFont() + 1))); applyFont(); });

        /* 11. 返回顶部 */
        var topBtn = document.createElement('button');
        topBtn.className = 'back-to-top'; topBtn.textContent = '↑'; topBtn.title = '返回顶部';
        document.body.appendChild(topBtn);
        window.addEventListener('scroll', function () {
            if (window.scrollY > 400) topBtn.classList.add('show'); else topBtn.classList.remove('show');
        }, { passive: true });
        topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

        /* 12. 已读勾选 + 学习进度 */
        var READ_KEY = 'stb-read-chapters';
        function getRead() { try { return JSON.parse(localStorage.getItem(READ_KEY) || '{}'); } catch (e) { return {}; } }
        function setRead(ch, val) { var r = getRead(); if (val) r[ch] = 1; else delete r[ch]; localStorage.setItem(READ_KEY, JSON.stringify(r)); updateProgress(); }
        var curChapter = location.pathname.split('/').pop() || 'index';
        document.querySelectorAll('.sidebar a, nav a').forEach(function (a) {
            var href = a.getAttribute('href') || '';
            var ch = href.split('/').pop();
            if (!ch || ch.indexOf('.html') < 0) return;
            var cb = document.createElement('input');
            cb.type = 'checkbox'; cb.className = 'chapter-check';
            cb.checked = !!getRead()[ch];
            cb.addEventListener('change', function () { setRead(ch, cb.checked); });
            a.insertBefore(cb, a.firstChild);
        });
        var totalCh = 0, readCh = 0;
        document.querySelectorAll('.sidebar .chapter-check, nav .chapter-check').forEach(function (cb) { totalCh++; if (cb.checked) readCh++; });
        function updateProgress() {
            var total = document.querySelectorAll('.sidebar .chapter-check, nav .chapter-check').length;
            var done = 0;
            document.querySelectorAll('.sidebar .chapter-check, nav .chapter-check').forEach(function (cb) { if (cb.checked) done++; });
            var el = document.getElementById('stb-progress');
            if (!el) { el = document.createElement('div'); el.id = 'stb-progress'; el.className = 'progress-label'; document.querySelector('.sidebar, nav') && document.querySelector('.sidebar, nav').appendChild(el); }
            if (el) el.textContent = '已读 ' + done + ' / ' + total + ' 章';
        }
        updateProgress();

        /* 13. 书签 */
        var BK_KEY = 'stb-bookmarks';
        function getBk() { try { return JSON.parse(localStorage.getItem(BK_KEY) || '[]'); } catch (e) { return []; } }
        var bkBtn = document.createElement('button');
        bkBtn.className = 'bookmark-btn';
        var bkList = getBk();
        var bkOn = bkList.some(function (b) { return b.path === location.pathname; });
        bkBtn.textContent = bkOn ? '已收藏 ★' : '收藏本章 ☆';
        if (bkOn) bkBtn.classList.add('on');
        bkBtn.addEventListener('click', function () {
            var list = getBk();
            var i = list.findIndex(function (b) { return b.path === location.pathname; });
            if (i >= 0) { list.splice(i, 1); bkBtn.textContent = '收藏本章 ☆'; bkBtn.classList.remove('on'); }
            else {
                list.unshift({ path: location.pathname, title: document.title.replace(/ - .*$/, '') });
                bkBtn.textContent = '已收藏 ★'; bkBtn.classList.add('on');
            }
            localStorage.setItem(BK_KEY, JSON.stringify(list.slice(0, 20)));
        });
        var c = document.querySelector('main .content, main');
        if (c) c.appendChild(bkBtn);

        /* 14. 最近阅读 */
        var REC_KEY = 'stb-recent';
        function pushRecent() {
            var list = [];
            try { list = JSON.parse(localStorage.getItem(REC_KEY) || '[]'); } catch (e) {}
            list = list.filter(function (x) { return x.path !== location.pathname; });
            list.unshift({ path: location.pathname, title: document.title.replace(/ - .*$/, '') });
            localStorage.setItem(REC_KEY, JSON.stringify(list.slice(0, 8)));
        }
        pushRecent();

        /* 15. 面包屑（从侧边栏标题推断） */
        var crumb = document.createElement('div');
        crumb.className = 'breadcrumb';
        var h1 = document.querySelector('main h1');
        if (h1) {
            crumb.innerHTML = '📖 <a href="index.html">目录</a> » ' + h1.textContent;
            h1.parentNode.insertBefore(crumb, h1);
        }

        /* 16. 相关推荐（上一章/下一章链接） */
        var navLinks = document.querySelectorAll('a[rel="prev"], a[rel="next"], .nav-chapters');
        var rec = document.createElement('div');
        rec.className = 'chapter-recommend';
        var recTitle = document.createElement('div');
        recTitle.className = 'rec-title'; recTitle.textContent = '继续阅读';
        rec.appendChild(recTitle);
        navLinks.forEach(function (a) {
            var clone = document.createElement('a');
            clone.href = a.getAttribute('href');
            var label = /prev/i.test(a.getAttribute('rel') || '') ? '← 上一章：' : '→ 下一章：';
            clone.textContent = label + (a.getAttribute('title') || '');
            rec.appendChild(clone);
        });
        if (c && navLinks.length) c.appendChild(rec);

        /* 17. 代码一键下载 */
        document.querySelectorAll('pre').forEach(function (pre, idx) {
            var code = pre.querySelector('code');
            if (!code) return;
            var m = (code.className || '').match(/language-([a-z0-9+#]+)/i);
            var ext = m ? m[1].replace(/\+/g, 'p') : 'txt';
            var btn = document.createElement('button');
            btn.className = 'code-download-btn';
            btn.textContent = '⬇';
            btn.title = '下载代码';
            btn.addEventListener('click', function () {
                var blob = new Blob([code.textContent], { type: 'text/plain;charset=utf-8' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'code-' + (idx + 1) + '.' + ext;
                a.click();
                URL.revokeObjectURL(a.href);
            });
            pre.appendChild(btn);
        });

        /* 18. 架构图缩放 */
        document.querySelectorAll('main svg').forEach(function (svg) {
            svg.classList.add('svg-zoomable');
            svg.addEventListener('click', function () {
                var ov = document.createElement('div');
                ov.className = 'zoom-overlay';
                var clone = svg.cloneNode(true);
                ov.appendChild(clone);
                document.body.appendChild(ov);
                ov.addEventListener('click', function () { ov.remove(); });
            });
        });

        /* 19. 页脚工具栏：勘误 + 分享 */
        var toolbar = document.createElement('div');
        toolbar.className = 'page-toolbar';
        var errata = document.createElement('a');
        errata.className = 'toolbar-btn';
        errata.textContent = '✍️ 提交勘误';
        errata.href = 'https://github.com/guotao0628/shutongbuddy/issues/new?title=' + encodeURIComponent('勘误：' + document.title) + '&body=' + encodeURIComponent('章节：' + location.href + '\n\n问题描述：');
        errata.target = '_blank';
        var share = document.createElement('button');
        share.className = 'toolbar-btn';
        share.textContent = '🔗 分享本章';
        share.addEventListener('click', function () {
            navigator.clipboard && navigator.clipboard.writeText(location.href);
            toast.textContent = '链接已复制，可分享';
            toast.classList.add('show');
            clearTimeout(toast._t);
            toast._t = setTimeout(function () { toast.classList.remove('show'); }, 1500);
        });
        toolbar.appendChild(errata); toolbar.appendChild(share);
        if (c) c.appendChild(toolbar);

        /* 20. 练习题交互（隐藏参考答案） */
        document.querySelectorAll('main p, main li').forEach(function (p) {
            if (/参考答案[:：]/.test(p.textContent) && p.textContent.length < 300) {
                p.classList.add('exercise-answer');
                var showBtn = document.createElement('button');
                showBtn.className = 'toolbar-btn';
                showBtn.textContent = '显示答案';
                showBtn.style.cssText = 'font-size:12px;padding:2px 10px;';
                p.parentNode.insertBefore(showBtn, p);
                showBtn.addEventListener('click', function () {
                    p.classList.toggle('show');
                    showBtn.textContent = p.classList.contains('show') ? '隐藏答案' : '显示答案';
                });
            }
        });

        /* 21. PWA 注册 */
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('service-worker.js').catch(function () {});
        }

        /* 22. 图片懒加载 */
        document.querySelectorAll('main img').forEach(function (img) { img.loading = 'lazy'; });

        /* 23. 划重点 / 高亮（选中文字即高亮，存 localStorage） */
        var HL_KEY = 'stb-hl-' + location.pathname;
        function getHl() { try { return JSON.parse(localStorage.getItem(HL_KEY) || '[]'); } catch (e) { return []; } }
        document.addEventListener('mouseup', function () {
            var sel = window.getSelection();
            if (!sel || sel.isCollapsed || !sel.toString().trim()) return;
            var range = sel.getRangeAt(0);
            if (!content || !content.contains(range.commonAncestorContainer)) return;
            var text = sel.toString().trim();
            if (text.length < 2 || text.length > 500) return;
            try {
                var mark = document.createElement('mark');
                mark.className = 'stb-hl';
                mark.title = '点击取消高亮';
                range.surroundContents(mark);
                var list = getHl(); list.push(text);
                localStorage.setItem(HL_KEY, JSON.stringify(list.slice(0, 100)));
                sel.removeAllRanges();
            } catch (e) {}
        });
        document.addEventListener('click', function (e) {
            if (e.target.classList && e.target.classList.contains('stb-hl')) {
                var t = e.target.textContent;
                e.target.replaceWith(document.createTextNode(t));
                var list = getHl().filter(function (x) { return x !== t; });
                localStorage.setItem(HL_KEY, JSON.stringify(list));
            }
        });
        (function restoreHl() {
            var list = getHl();
            if (!list.length || !content) return;
            var walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
            var nodes = [];
            while (walker.nextNode()) nodes.push(walker.currentNode);
            nodes.forEach(function (node) {
                var t = node.nodeValue;
                var hit = list.find(function (x) { return t.indexOf(x) >= 0; });
                if (!hit || node.parentElement.closest('pre, code, mark')) return;
                var span = document.createElement('mark');
                span.className = 'stb-hl';
                span.title = '点击取消高亮';
                node.nodeValue = '';
                span.textContent = hit;
                var rest = t.slice(t.indexOf(hit) + hit.length);
                node.parentElement.insertBefore(span, node.nextSibling);
                node.parentElement.insertBefore(document.createTextNode(rest), span.nextSibling);
            });
        })();

        /* 24. 读书笔记（双击选中文字写笔记） */
        document.addEventListener('dblclick', function (e) {
            var sel = window.getSelection();
            if (!sel || sel.isCollapsed || !sel.toString().trim()) return;
            var text = sel.toString().trim();
            if (text.length < 2 || text.length > 300) return;
            var pop = document.createElement('div');
            pop.className = 'note-popup';
            pop.style.left = (e.clientX + 10) + 'px';
            pop.style.top = (e.clientY + 10) + 'px';
            pop.innerHTML = '<div>✍️ 笔记（针对：「' + text.slice(0, 30) + '」）</div>' +
                '<textarea placeholder="写下你的笔记…"></textarea><br>' +
                '<button>保存</button>';
            document.body.appendChild(pop);
            pop.querySelector('button').addEventListener('click', function () {
                var note = pop.querySelector('textarea').value.trim();
                if (note) {
                    var notes = [];
                    try { notes = JSON.parse(localStorage.getItem('stb-notes') || '[]'); } catch (e) {}
                    notes.unshift({ path: location.pathname, quote: text.slice(0, 50), note: note, time: new Date().toLocaleString() });
                    localStorage.setItem('stb-notes', JSON.stringify(notes.slice(0, 200)));
                    toast.textContent = '笔记已保存';
                    toast.classList.add('show');
                    clearTimeout(toast._t);
                    toast._t = setTimeout(function () { toast.classList.remove('show'); }, 1200);
                }
                pop.remove();
            });
            document.addEventListener('click', function close(ev) { if (!pop.contains(ev.target)) pop.remove(); }, { once: true });
        });

        /* 25. 章节小测验（练习题标记掌握） */
        document.querySelectorAll('main ol li, main ul li').forEach(function (li) {
            var txt = li.textContent.trim();
            if (txt.length < 8 || li.querySelector('.quiz-btn')) return;
            var btn = document.createElement('button');
            btn.className = 'quiz-btn';
            btn.textContent = '✓ 会了';
            btn.addEventListener('click', function () {
                btn.classList.toggle('done');
                btn.textContent = btn.classList.contains('done') ? '✓ 已掌握' : '✓ 会了';
            });
            li.appendChild(btn);
        });

        /* 26. 学习时长统计 */
        var TIME_KEY = 'stb-time-' + location.pathname;
        var tStart = Date.now();
        var tAcc = parseInt(localStorage.getItem(TIME_KEY) || '0', 10);
        window.addEventListener('beforeunload', function () {
            tAcc += Math.round((Date.now() - tStart) / 1000);
            localStorage.setItem(TIME_KEY, String(tAcc));
        });

        /* 27. 术语表交互（英文术语加 tooltip） */
        var GLOSSARY = {
            'Profile': '一组命名好的插件树组合（web/headless/sdk/sdk-minimal/acp）',
            'Seam': '能力接缝：一个可替换能力的三角色契约',
            'PTC': '程序化工具调用（Programmatic Tool Calls）',
            'Turn': '轮次：从零到多个 Step 构成',
            'Step': '步骤：一次模型请求加上它触发的工具调用',
            'Session': '会话：一次持续的人机协作',
            'Microkernel': '微内核：没有特权核心的架构，一切皆插件',
            'Cordis': 'DeepSeek Harness 的插件框架底座',
            'Compaction': '上下文压缩'
        };
        (function glossary() {
            if (!content) return;
            var walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
            var nodes = [];
            while (walker.nextNode()) nodes.push(walker.currentNode);
            nodes.forEach(function (node) {
                if (node.parentElement.closest('pre, code, a, mark, .glossary-term')) return;
                var t = node.nodeValue;
                var any = false;
                Object.keys(GLOSSARY).forEach(function (term) {
                    var re = new RegExp('\\b' + term + '\\b', 'g');
                    if (re.test(t)) any = true;
                });
                if (!any) return;
                var frag = document.createDocumentFragment();
                var last = 0;
                var reAll = new RegExp('\\b(' + Object.keys(GLOSSARY).join('|') + ')\\b', 'g');
                var m;
                while ((m = reAll.exec(t)) !== null) {
                    if (m.index > last) frag.appendChild(document.createTextNode(t.slice(last, m.index)));
                    var span = document.createElement('span');
                    span.className = 'glossary-term';
                    span.textContent = m[0];
                    span.title = GLOSSARY[m[0]];
                    frag.appendChild(span);
                    last = m.index + m[0].length;
                }
                if (last < t.length) frag.appendChild(document.createTextNode(t.slice(last)));
                node.parentElement.replaceChild(frag, node);
            });
        })();

        /* 28. 代码块 GitHub 链接 */
        document.querySelectorAll('pre').forEach(function (pre) {
            var gh = document.createElement('a');
            gh.className = 'code-gh-link';
            gh.textContent = 'GitHub';
            gh.href = 'https://github.com/guotao0628/shutongbuddy/tree/main/plugins/shu-tong-buddy/src';
            gh.target = '_blank';
            gh.title = '在 GitHub 查看配套代码';
            pre.appendChild(gh);
        });

        /* 29. 章末参考文献 */
        var refs = [];
        document.querySelectorAll('main a[href^="http"]').forEach(function (a) {
            var href = a.getAttribute('href');
            if (refs.indexOf(href) < 0) refs.push(href);
        });
        if (refs.length) {
            var refBox = document.createElement('div');
            refBox.className = 'chapter-refs';
            var rt = document.createElement('div');
            rt.className = 'ref-title'; rt.textContent = '本章参考链接';
            refBox.appendChild(rt);
            refs.forEach(function (href) {
                var a = document.createElement('a');
                a.href = href; a.textContent = href; a.target = '_blank';
                refBox.appendChild(a);
            });
            if (c) c.appendChild(refBox);
        }

        /* 30. 单章打印 */
        var printBtn = document.createElement('button');
        printBtn.className = 'print-btn';
        printBtn.textContent = '🖨 打印本章';
        printBtn.addEventListener('click', function () { window.print(); });
        if (toolbar) toolbar.appendChild(printBtn);

        /* 31. 章节点赞 */
        var LIKE_KEY = 'stb-like-' + location.pathname;
        var likeBtn = document.createElement('button');
        likeBtn.className = 'like-btn';
        var liked = localStorage.getItem(LIKE_KEY) === '1';
        likeBtn.textContent = liked ? '👍 已赞' : '👍 赞本章';
        if (liked) likeBtn.classList.add('on');
        likeBtn.addEventListener('click', function () {
            liked = !liked;
            localStorage.setItem(LIKE_KEY, liked ? '1' : '0');
            likeBtn.textContent = liked ? '👍 已赞' : '👍 赞本章';
            likeBtn.classList.toggle('on', liked);
        });
        if (toolbar) toolbar.appendChild(likeBtn);

        /* 32. 邮件订阅 */
        var subBox = document.createElement('div');
        subBox.className = 'subscribe-box';
        subBox.innerHTML = '📬 订阅更新：发送邮件至 <a href="mailto:guotao3s@163.com?subject=订阅《DeepSeek Harness 应用开发实践》更新">guotao3s@163.com</a>，主题注明「订阅更新」';
        if (c) c.appendChild(subBox);
    });
})();
</script>
