<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="favicon.svg">
<meta name="theme-color" content="#660874">
<style>
/* ==================== ShuTongBuddy 在线书样式与交互 ==================== */

/* ---------- 全局布局 ---------- */
:root {
    --content-max-width: 860px;
    --code-font-size: 0.85em;
    --tsinghua: #660874;
    --tsinghua-light: #b28ad1;
}

html, body {
    font-size: 15px;
    line-height: 1.7;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial,
                 "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
}

/* 标题：宋体衬线 + 加粗 + 字距（书卷气） */
h1, h2, h3 {
    font-family: "Noto Serif SC", "Source Han Serif SC", "STSong", "SimSun", serif;
    font-weight: 700;
    letter-spacing: 0.02em;
}
h1 { font-size: 1.7em; margin-bottom: 0.8em; }
h2 { font-size: 1.35em; margin-top: 2em; }
h3 { font-size: 1.15em; margin-top: 1.6em; }
p { margin: 0.8em 0; }

/* 行内代码：淡紫底 + 圆角 */
code {
    font-family: "Cascadia Code", Consolas, "Source Code Pro", Menlo, monospace;
}
:not(pre) > code {
    background: rgba(102, 8, 116, 0.07);
    color: #660874;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.9em;
}
pre, pre code {
    font-family: "Cascadia Code", Consolas, "Source Code Pro", Menlo, monospace;
}

/* ---------- 明主题（清华紫） ---------- */
.light {
    --fg: #2f2f2f;
    --links: #660874;
    --sidebar-active: #660874;
    --sidebar-header-border-color: #660874;
    --inline-code-color: #660874;
    --table-header-bg: #f1e6f5;
    --table-alternate-bg: #faf6fc;
    --quote-bg: #faf5fc;
    --quote-border: #c99bd4;
}

/* ---------- 暗主题（提亮清华紫） ---------- */
.coal, .navy, .ayu, .rust {
    --links: #c39bd8;
    --sidebar-active: #c39bd8;
    --sidebar-header-border-color: #c39bd8;
    --inline-code-color: #c39bd8;
}
.coal :not(pre) > code, .navy :not(pre) > code, .ayu :not(pre) > code, .rust :not(pre) > code {
    background: rgba(178, 138, 209, 0.15);
    color: #c39bd8;
}

/* ---------- 链接悬停 ---------- */
a:hover { text-decoration: underline; }
.light a:hover { color: #4a0656; }
.coal a:hover, .navy a:hover, .ayu a:hover, .rust a:hover { color: #d9b8e8; }

/* ---------- 代码高亮（清华紫系） ---------- */
.hljs-keyword, .hljs-selector-tag, .hljs-literal { color: #660874; font-weight: 500; }
.hljs-string, .hljs-attr, .hljs-regexp { color: #1a7f37; }
.hljs-comment, .hljs-quote { color: #8a8a8a; font-style: italic; }
.hljs-number, .hljs-symbol { color: #b3541e; }
.hljs-function, .hljs-title, .hljs-section { color: #205ea6; }
.hljs-type, .hljs-class, .hljs-built_in { color: #660874; }
.hljs-variable, .hljs-template-variable { color: #c7254e; }
/* 暗主题代码高亮 */
.coal .hljs-keyword, .navy .hljs-keyword, .ayu .hljs-keyword, .rust .hljs-keyword { color: #c39bd8; }
.coal .hljs-string, .navy .hljs-string, .ayu .hljs-string, .rust .hljs-string { color: #7ee2a0; }
.coal .hljs-number, .navy .hljs-number, .ayu .hljs-number, .rust .hljs-number { color: #f0a86c; }
.coal .hljs-function, .navy .hljs-function, .ayu .hljs-function, .rust .hljs-function { color: #7fb3e8; }

/* ---------- 代码块 ---------- */
pre {
    border-radius: 6px;
    border: 1px solid rgba(102, 8, 116, 0.12);
    overflow: auto;
    position: relative;
}
pre code { line-height: 1.6; }
/* 语言标签栏 */
.code-lang-tag {
    position: absolute; top: 6px; right: 8px;
    padding: 1px 9px; border-radius: 10px;
    background: #660874; color: #fff;
    font-size: 11px; font-family: Consolas, monospace; letter-spacing: 0.5px;
    opacity: 0.85; z-index: 1;
}
pre.code-collapsed { max-height: 420px; position: relative; overflow: hidden; }
pre.code-collapsed::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 60px;
    background: linear-gradient(transparent, var(--bg, #fff));
}
.code-expand-btn {
    display: block; margin: 8px auto; padding: 6px 18px;
    font-size: 13px; border: 1px solid #660874; border-radius: 16px;
    background: transparent; color: #660874; cursor: pointer;
}
.code-expand-btn:hover { background: #660874; color: #fff; }

/* ---------- 复制按钮提示 ---------- */
.copy-toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    padding: 8px 20px; border-radius: 20px; background: #660874; color: #fff;
    font-size: 13px; z-index: 9999; opacity: 0; transition: opacity .3s; pointer-events: none;
}
.copy-toast.show { opacity: 1; }

/* ---------- 表格 ---------- */
table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
table thead tr th {
    background: var(--table-header-bg); color: #660874; font-weight: 600;
}
table tbody tr:nth-child(even) { background: var(--table-alternate-bg); }
table th, table td { padding: 6px 12px; border: 1px solid var(--table-border-color, #eee); }

/* ---------- 引用块 / 提示块（图标） ---------- */
blockquote {
    background: var(--quote-bg); border-left: 4px solid var(--quote-border);
    border-radius: 0 6px 6px 0; padding: 10px 16px; margin: 1em 0;
}
.markdown-alert-note .markdown-alert-title::before { content: "📝 "; }
.markdown-alert-tip .markdown-alert-title::before { content: "💡 "; }
.markdown-alert-important .markdown-alert-title::before { content: "⭐ "; }
.markdown-alert-warning .markdown-alert-title::before { content: "⚠️ "; }
.markdown-alert-caution .markdown-alert-title::before { content: "🚫 "; }
.markdown-alert-note { border-left-color: #660874; }
.markdown-alert-tip { border-left-color: #1a7f37; }
.markdown-alert-important { border-left-color: #8250df; }
.markdown-alert-warning { border-left-color: #b3541e; }
.markdown-alert-caution { border-left-color: #c7254e; }

/* ---------- 图片 + 说明 ---------- */
.content img, main img { max-width: 100%; height: auto; display: block; margin: 1em auto; border-radius: 4px; }
.img-caption { text-align: center; color: #8a8a8a; font-size: 13px; margin: -8px 0 16px; }

/* ---------- 章标题视觉（紫色下划线 + 左侧竖条） ---------- */
main .content h1, main h1 {
    position: relative;
    padding-left: 14px;
    border-left: 4px solid #660874;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(102, 8, 116, 0.2);
}

/* ---------- 本页目录 ---------- */
.page-toc {
    background: var(--quote-bg, #faf5fc);
    border: 1px solid var(--quote-border, #c99bd4);
    border-radius: 8px; padding: 12px 18px; margin: 1em 0 1.5em; font-size: 14px;
}
.page-toc .toc-title { font-weight: 600; color: #660874; margin-bottom: 6px; }
.page-toc a { display: block; color: var(--links); text-decoration: none; padding: 2px 0; }
.page-toc a.l3 { padding-left: 1.2em; font-size: 13px; }
.page-toc a:hover { text-decoration: underline; }

/* ---------- 阅读进度条 ---------- */
.reading-progress {
    position: fixed; top: 0; left: 0; height: 3px; width: 0;
    background: linear-gradient(90deg, #660874, #a67cba); z-index: 9998; transition: width .1s ease;
}

/* ---------- 页脚导航（卡片化） ---------- */
.nav-chapters {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 16px; border-radius: 8px;
    border: 1px solid rgba(102, 8, 116, 0.15);
    background: var(--quote-bg, #faf5fc);
    color: #660874 !important; font-weight: 500;
}
.nav-chapters:hover { background: #660874; color: #fff !important; }

/* ---------- 滚动条 ---------- */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: rgba(102, 8, 116, 0.35); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: rgba(102, 8, 116, 0.6); }
::-webkit-scrollbar-track { background: transparent; }

/* ---------- 侧边栏悬停 / 分隔线 ---------- */
.sidebar a:hover { background: rgba(102, 8, 116, 0.08); }
.sidebar .chapter-item { border-bottom: 1px solid rgba(102, 8, 116, 0.08); }

/* ---------- 搜索命中高亮 ---------- */
.searchresults mark, .content mark { background: #e3b9ef; color: #660874; }

/* ---------- 章节间距 ---------- */
main .content { padding-bottom: 3em; }

/* ---------- 移动端 ---------- */
@media (max-width: 768px) {
    html, body { font-size: 14.5px; }
    :root { --content-max-width: 100%; --page-padding: 12px; }
    h1 { font-size: 1.5em; }
    h2 { font-size: 1.25em; }
    pre { font-size: 0.82em; }
    table { font-size: 0.85em; }
}
/* 移动端表格卡片化 */
@media (max-width: 600px) {
    table, thead, tbody, tr, th, td { display: block; }
    table thead { display: none; }
    table tbody tr {
        margin-bottom: 12px;
        border: 1px solid var(--table-border-color, #eee); border-radius: 6px;
    }
    table td {
        display: flex; justify-content: space-between; align-items: center;
        padding: 6px 12px; border: none; border-bottom: 1px dashed rgba(102,8,116,0.08);
    }
    table td::before {
        content: attr(data-label);
        font-weight: 600; color: #660874; margin-right: 12px; flex-shrink: 0;
    }
}
/* ========== 新增功能样式 ========== */
/* 字号调节 */
.font-ctl-btn {
    border: 1px solid #660874; background: transparent; color: #660874;
    border-radius: 14px; padding: 2px 10px; margin: 0 3px; cursor: pointer; font-size: 13px;
}
.font-ctl-btn:hover { background: #660874; color: #fff; }
/* 返回顶部 */
.back-to-top {
    position: fixed; right: 20px; bottom: 24px; width: 40px; height: 40px;
    border-radius: 50%; background: #660874; color: #fff; border: none;
    font-size: 18px; cursor: pointer; opacity: 0; pointer-events: none;
    transition: opacity .3s; z-index: 9997; box-shadow: 0 2px 8px rgba(102,8,116,.3);
}
.back-to-top.show { opacity: 1; pointer-events: auto; }
/* 已读勾选 + 书签 */
.chapter-check { margin-right: 6px; accent-color: #660874; }
.bookmark-btn {
    border: 1px solid #660874; background: transparent; color: #660874;
    border-radius: 14px; padding: 3px 12px; cursor: pointer; font-size: 13px; margin-top: 8px;
}
.bookmark-btn.on { background: #660874; color: #fff; }
/* 代码下载 */
.code-download-btn {
    position: absolute; top: 6px; right: 64px; padding: 1px 9px; border-radius: 10px;
    background: #660874; color: #fff; border: none; font-size: 11px; cursor: pointer;
    opacity: 0.85; z-index: 1; font-family: Consolas, monospace;
}
.code-download-btn:hover { opacity: 1; }
/* 勘误 + 分享（页脚工具栏） */
.page-toolbar { display: flex; gap: 10px; margin-top: 2.5em; flex-wrap: wrap; }
.toolbar-btn {
    display: inline-block; padding: 6px 16px; border-radius: 16px; font-size: 13px;
    border: 1px solid #660874; color: #660874; text-decoration: none; cursor: pointer;
    background: transparent;
}
.toolbar-btn:hover { background: #660874; color: #fff; }
/* 练习题答案 */
.exercise-answer {
    display: none; margin-top: 6px; padding: 8px 14px; border-radius: 6px;
    background: #faf5fc; border-left: 3px solid #660874; color: #555; font-size: 14px;
}
.exercise-answer.show { display: block; }
/* 面包屑 */
.breadcrumb { font-size: 13px; color: #888; margin-bottom: 1em; }
.breadcrumb a { color: #660874; text-decoration: none; }
/* 相关推荐 */
.chapter-recommend {
    margin-top: 2.5em; padding: 14px 18px; border-radius: 8px;
    background: var(--quote-bg, #faf5fc); border: 1px solid var(--quote-border, #c99bd4);
    font-size: 14px;
}
.chapter-recommend .rec-title { font-weight: 600; color: #660874; margin-bottom: 8px; }
.chapter-recommend a { display: block; color: var(--links); text-decoration: none; padding: 3px 0; }
.chapter-recommend a:hover { text-decoration: underline; }
/* 学习进度 */
.progress-label { font-size: 12px; color: #888; }
/* 架构图缩放 */
.svg-zoomable { cursor: zoom-in; }
.zoom-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.8); z-index: 10000;
    display: flex; align-items: center; justify-content: center; cursor: zoom-out;
}
.zoom-overlay svg, .zoom-overlay img { max-width: 92vw; max-height: 92vh; background: #fff; border-radius: 8px; }
</style>


<script>
(function () {
    function ready(fn) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
        else fn();
    }

    ready(function () {
        /* 1. 阅读进度条 */
        var bar = document.createElement('div');
        bar.className = 'reading-progress';
        document.body.appendChild(bar);
        window.addEventListener('scroll', function () {
            var h = document.documentElement;
            var scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
            bar.style.width = (isNaN(scrolled) ? 0 : scrolled) + '%';
        }, { passive: true });

        /* 2. 阅读位置记忆 */
        var KEY = 'stb-scroll-' + location.pathname;
        var saved = localStorage.getItem(KEY);
        if (saved) window.scrollTo(0, parseInt(saved, 10));
        var t;
        window.addEventListener('scroll', function () {
            clearTimeout(t);
            t = setTimeout(function () { localStorage.setItem(KEY, String(window.scrollY)); }, 200);
        }, { passive: true });

        /* 3. 代码复制提示 */
        var toast = document.createElement('div');
        toast.className = 'copy-toast';
        toast.textContent = '已复制到剪贴板';
        document.body.appendChild(toast);
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('button');
            if (btn && /copy/i.test(btn.textContent || '')) {
                toast.classList.add('show');
                clearTimeout(toast._t);
                toast._t = setTimeout(function () { toast.classList.remove('show'); }, 1500);
            }
        });

        /* 4. 代码块语言标签 */
        document.querySelectorAll('pre').forEach(function (pre) {
            var code = pre.querySelector('code');
            if (!code) return;
            var m = (code.className || '').match(/language-([a-z0-9+#]+)/i);
            if (m) {
                var tag = document.createElement('span');
                tag.className = 'code-lang-tag';
                tag.textContent = m[1];
                pre.appendChild(tag);
            }
        });

        /* 5. 超长代码折叠 */
        document.querySelectorAll('pre').forEach(function (pre) {
            if (pre.scrollHeight > 500 && pre.clientHeight > 0) {
                pre.classList.add('code-collapsed');
                var btn = document.createElement('button');
                btn.className = 'code-expand-btn';
                btn.textContent = '展开全部代码';
                pre.parentNode.insertBefore(btn, pre.nextSibling);
                btn.addEventListener('click', function () {
                    pre.classList.remove('code-collapsed');
                    btn.remove();
                });
            }
        });

        /* 6. 本页目录 */
        var content = document.querySelector('main .content, main');
        if (content) {
            var heads = content.querySelectorAll('h2, h3');
            if (heads.length >= 3) {
                var toc = document.createElement('nav');
                toc.className = 'page-toc';
                var title = document.createElement('div');
                title.className = 'toc-title';
                title.textContent = '本页目录';
                toc.appendChild(title);
                heads.forEach(function (h) {
                    if (!h.id) h.id = 'sec-' + Math.random().toString(36).slice(2, 8);
                    var a = document.createElement('a');
                    a.href = '#' + h.id;
                    a.textContent = h.textContent;
                    if (h.tagName === 'H3') a.className = 'l3';
                    toc.appendChild(a);
                });
                var firstH = content.querySelector('h1, h2, h3, p');
                if (firstH) content.insertBefore(toc, firstH);
            }
        }

        /* 7. 图片说明（用 alt 文本做 caption） */
        document.querySelectorAll('main img').forEach(function (img) {
            var alt = img.getAttribute('alt');
            if (alt && alt.trim() && alt.indexOf('![') !== 0 && img.closest('pre') === null) {
                var cap = document.createElement('div');
                cap.className = 'img-caption';
                cap.textContent = alt;
                if (img.nextSibling) img.parentNode.insertBefore(cap, img.nextSibling);
                else img.parentNode.appendChild(cap);
            }
        });

        /* 8. 移动端表格卡片化（给 td 加 data-label） */
        document.querySelectorAll('table').forEach(function (table) {
            var headers = [];
            table.querySelectorAll('thead th').forEach(function (th) { headers.push(th.textContent.trim()); });
            if (!headers.length) return;
            table.querySelectorAll('tbody tr').forEach(function (tr) {
                tr.querySelectorAll('td').forEach(function (td, i) {
                    if (headers[i]) td.setAttribute('data-label', headers[i]);
                });
            });
        });

        /* 9. 评论区 giscus */
        (function loadGiscus() {
            var repoId = 'R_kgDOUaBS6w';
            var categoryId = 'DIC_kwDOUaBS684DFkpJ';
            if (!repoId || !categoryId) return;
            var container = document.createElement('div');
            container.id = 'giscus-container';
            container.style.marginTop = '2.5rem';
            var main = document.querySelector('main');
            if (!main) return;
            main.appendChild(container);
            var s = document.createElement('script');
            s.src = 'https://giscus.app/client.js';
            s.setAttribute('data-repo', 'guotao0628/shutongbuddy');
            s.setAttribute('data-repo-id', repoId);
            s.setAttribute('data-category', 'Announcements');
            s.setAttribute('data-category-id', categoryId);
            s.setAttribute('data-mapping', 'pathname');
            s.setAttribute('data-reactions-enabled', '1');
            s.setAttribute('data-input-position', 'bottom');
            s.setAttribute('data-theme', 'preferred_color_scheme');
            s.setAttribute('data-lang', 'zh-CN');
            s.setAttribute('crossorigin', 'anonymous');
            s.async = true;
            container.appendChild(s);
        })();

        /* 10. 字号调节 A-/A+ */
        var fontCtl = document.createElement('div');
        fontCtl.style.cssText = 'position:fixed;right:20px;bottom:74px;z-index:9997;display:flex;flex-direction:column;gap:6px;';
        var decBtn = document.createElement('button');
        decBtn.className = 'font-ctl-btn'; decBtn.textContent = 'A-'; decBtn.title = '缩小字号';
        var incBtn = document.createElement('button');
        incBtn.className = 'font-ctl-btn'; incBtn.textContent = 'A+'; incBtn.title = '放大字号';
        fontCtl.appendChild(decBtn); fontCtl.appendChild(incBtn);
        document.body.appendChild(fontCtl);
        var FONT_KEY = 'stb-font-size';
        function getFont() { return parseInt(localStorage.getItem(FONT_KEY) || '15', 10); }
        function applyFont() { document.documentElement.style.fontSize = getFont() + 'px'; }
        applyFont();
        decBtn.addEventListener('click', function () { localStorage.setItem(FONT_KEY, String(Math.max(12, getFont() - 1))); applyFont(); });
        incBtn.addEventListener('click', function () { localStorage.setItem(FONT_KEY, String(Math.min(20, getFont() + 1))); applyFont(); });

        /* 11. 返回顶部 */
        var topBtn = document.createElement('button');
        topBtn.className = 'back-to-top'; topBtn.textContent = '↑'; topBtn.title = '返回顶部';
        document.body.appendChild(topBtn);
        window.addEventListener('scroll', function () {
            if (window.scrollY > 400) topBtn.classList.add('show'); else topBtn.classList.remove('show');
        }, { passive: true });
        topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

        /* 12. 已读勾选 + 学习进度 */
        var READ_KEY = 'stb-read-chapters';
        function getRead() { try { return JSON.parse(localStorage.getItem(READ_KEY) || '{}'); } catch (e) { return {}; } }
        function setRead(ch, val) { var r = getRead(); if (val) r[ch] = 1; else delete r[ch]; localStorage.setItem(READ_KEY, JSON.stringify(r)); updateProgress(); }
        var curChapter = location.pathname.split('/').pop() || 'index';
        document.querySelectorAll('.sidebar a, nav a').forEach(function (a) {
            var href = a.getAttribute('href') || '';
            var ch = href.split('/').pop();
            if (!ch || ch.indexOf('.html') < 0) return;
            var cb = document.createElement('input');
            cb.type = 'checkbox'; cb.className = 'chapter-check';
            cb.checked = !!getRead()[ch];
            cb.addEventListener('change', function () { setRead(ch, cb.checked); });
            a.insertBefore(cb, a.firstChild);
        });
        var totalCh = 0, readCh = 0;
        document.querySelectorAll('.sidebar .chapter-check, nav .chapter-check').forEach(function (cb) { totalCh++; if (cb.checked) readCh++; });
        function updateProgress() {
            var total = document.querySelectorAll('.sidebar .chapter-check, nav .chapter-check').length;
            var done = 0;
            document.querySelectorAll('.sidebar .chapter-check, nav .chapter-check').forEach(function (cb) { if (cb.checked) done++; });
            var el = document.getElementById('stb-progress');
            if (!el) { el = document.createElement('div'); el.id = 'stb-progress'; el.className = 'progress-label'; document.querySelector('.sidebar, nav') && document.querySelector('.sidebar, nav').appendChild(el); }
            if (el) el.textContent = '已读 ' + done + ' / ' + total + ' 章';
        }
        updateProgress();

        /* 13. 书签 */
        var BK_KEY = 'stb-bookmarks';
        function getBk() { try { return JSON.parse(localStorage.getItem(BK_KEY) || '[]'); } catch (e) { return []; } }
        var bkBtn = document.createElement('button');
        bkBtn.className = 'bookmark-btn';
        var bkList = getBk();
        var bkOn = bkList.some(function (b) { return b.path === location.pathname; });
        bkBtn.textContent = bkOn ? '已收藏 ★' : '收藏本章 ☆';
        if (bkOn) bkBtn.classList.add('on');
        bkBtn.addEventListener('click', function () {
            var list = getBk();
            var i = list.findIndex(function (b) { return b.path === location.pathname; });
            if (i >= 0) { list.splice(i, 1); bkBtn.textContent = '收藏本章 ☆'; bkBtn.classList.remove('on'); }
            else {
                list.unshift({ path: location.pathname, title: document.title.replace(/ - .*$/, '') });
                bkBtn.textContent = '已收藏 ★'; bkBtn.classList.add('on');
            }
            localStorage.setItem(BK_KEY, JSON.stringify(list.slice(0, 20)));
        });
        var c = document.querySelector('main .content, main');
        if (c) c.appendChild(bkBtn);

        /* 14. 最近阅读 */
        var REC_KEY = 'stb-recent';
        function pushRecent() {
            var list = [];
            try { list = JSON.parse(localStorage.getItem(REC_KEY) || '[]'); } catch (e) {}
            list = list.filter(function (x) { return x.path !== location.pathname; });
            list.unshift({ path: location.pathname, title: document.title.replace(/ - .*$/, '') });
            localStorage.setItem(REC_KEY, JSON.stringify(list.slice(0, 8)));
        }
        pushRecent();

        /* 15. 面包屑（从侧边栏标题推断） */
        var crumb = document.createElement('div');
        crumb.className = 'breadcrumb';
        var h1 = document.querySelector('main h1');
        if (h1) {
            crumb.innerHTML = '📖 <a href="index.html">目录</a> » ' + h1.textContent;
            h1.parentNode.insertBefore(crumb, h1);
        }

        /* 16. 相关推荐（上一章/下一章链接） */
        var navLinks = document.querySelectorAll('a[rel="prev"], a[rel="next"], .nav-chapters');
        var rec = document.createElement('div');
        rec.className = 'chapter-recommend';
        var recTitle = document.createElement('div');
        recTitle.className = 'rec-title'; recTitle.textContent = '继续阅读';
        rec.appendChild(recTitle);
        navLinks.forEach(function (a) {
            var clone = document.createElement('a');
            clone.href = a.getAttribute('href');
            var label = /prev/i.test(a.getAttribute('rel') || '') ? '← 上一章：' : '→ 下一章：';
            clone.textContent = label + (a.getAttribute('title') || '');
            rec.appendChild(clone);
        });
        if (c && navLinks.length) c.appendChild(rec);

        /* 17. 代码一键下载 */
        document.querySelectorAll('pre').forEach(function (pre, idx) {
            var code = pre.querySelector('code');
            if (!code) return;
            var m = (code.className || '').match(/language-([a-z0-9+#]+)/i);
            var ext = m ? m[1].replace(/\+/g, 'p') : 'txt';
            var btn = document.createElement('button');
            btn.className = 'code-download-btn';
            btn.textContent = '⬇';
            btn.title = '下载代码';
            btn.addEventListener('click', function () {
                var blob = new Blob([code.textContent], { type: 'text/plain;charset=utf-8' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'code-' + (idx + 1) + '.' + ext;
                a.click();
                URL.revokeObjectURL(a.href);
            });
            pre.appendChild(btn);
        });

        /* 18. 架构图缩放 */
        document.querySelectorAll('main svg').forEach(function (svg) {
            svg.classList.add('svg-zoomable');
            svg.addEventListener('click', function () {
                var ov = document.createElement('div');
                ov.className = 'zoom-overlay';
                var clone = svg.cloneNode(true);
                ov.appendChild(clone);
                document.body.appendChild(ov);
                ov.addEventListener('click', function () { ov.remove(); });
            });
        });

        /* 19. 页脚工具栏：勘误 + 分享 */
        var toolbar = document.createElement('div');
        toolbar.className = 'page-toolbar';
        var errata = document.createElement('a');
        errata.className = 'toolbar-btn';
        errata.textContent = '✍️ 提交勘误';
        errata.href = 'https://github.com/guotao0628/shutongbuddy/issues/new?title=' + encodeURIComponent('勘误：' + document.title) + '&body=' + encodeURIComponent('章节：' + location.href + '\n\n问题描述：');
        errata.target = '_blank';
        var share = document.createElement('button');
        share.className = 'toolbar-btn';
        share.textContent = '🔗 分享本章';
        share.addEventListener('click', function () {
            navigator.clipboard && navigator.clipboard.writeText(location.href);
            toast.textContent = '链接已复制，可分享';
            toast.classList.add('show');
            clearTimeout(toast._t);
            toast._t = setTimeout(function () { toast.classList.remove('show'); }, 1500);
        });
        toolbar.appendChild(errata); toolbar.appendChild(share);
        if (c) c.appendChild(toolbar);

        /* 20. 练习题交互（隐藏参考答案） */
        document.querySelectorAll('main p, main li').forEach(function (p) {
            if (/参考答案[:：]/.test(p.textContent) && p.textContent.length < 300) {
                p.classList.add('exercise-answer');
                var showBtn = document.createElement('button');
                showBtn.className = 'toolbar-btn';
                showBtn.textContent = '显示答案';
                showBtn.style.cssText = 'font-size:12px;padding:2px 10px;';
                p.parentNode.insertBefore(showBtn, p);
                showBtn.addEventListener('click', function () {
                    p.classList.toggle('show');
                    showBtn.textContent = p.classList.contains('show') ? '隐藏答案' : '显示答案';
                });
            }
        });

        /* 21. PWA 注册 */
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('service-worker.js').catch(function () {});
        }
    });
})();
</script>
